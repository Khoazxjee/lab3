@model Book
@{
    bool editing = ViewData["Editing"] is true;
}
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
@if (editing) { <input asp-for="Id" type="hidden" /> }
<div class="form-group"><label asp-for="Title"></label><input asp-for="Title" class="form-control" placeholder="Tên sách" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="form-group"><label asp-for="AuthorId"></label><select asp-for="AuthorId" asp-items="ViewBag.authors" class="form-select"><option value="">Chọn tác giả</option></select><span asp-validation-for="AuthorId" class="text-danger"></span></div>
<div class="form-group"><label asp-for="GenreId"></label><select asp-for="GenreId" asp-items="ViewBag.genres" class="form-select" data-val-required="Vui lòng chọn thể loại"><option value="">Chọn Thể loại</option></select><span asp-validation-for="GenreId" class="text-danger"></span></div>
<div class="form-group"><label asp-for="Price"></label><input asp-for="Price" type="text" inputmode="decimal" class="form-control" placeholder="Giá sách" data-val-required="Vui lòng nhập giá sách" /><span asp-validation-for="Price" class="text-danger"></span></div>
<div class="form-group"><label asp-for="TotalPage"></label><input asp-for="TotalPage" type="text" inputmode="numeric" class="form-control" placeholder="Tổng số trang" data-val-required="Vui lòng nhập tổng số trang" /><span asp-validation-for="TotalPage" class="text-danger"></span></div>
<div class="form-group">
    <label asp-for="Image"></label>
    <input name="Image" id="Image" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" data-val="true"
           data-val-bookimage="Vui lòng chọn ảnh JPG, PNG hoặc WebP hợp lệ, tối đa 5 MB" data-existing="@(string.IsNullOrEmpty(Model.Image) ? "false" : "true")" />
    <span asp-validation-for="Image" class="text-danger"></span>
    <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.Image) ? null : Model.Image)" hidden="@(string.IsNullOrEmpty(Model.Image))" alt="Ảnh bìa sách" width="150" height="190" />
</div>
<div class="form-group"><label asp-for="Sumary"></label><textarea asp-for="Sumary" class="form-control" rows="3" placeholder="Nội dung giới thiệu sách..."></textarea><span asp-validation-for="Sumary" class="text-danger"></span></div>
<div class="form-actions"><button type="submit" class="btn btn-primary">Lưu lại</button><a asp-action="Index">Quay lại danh sách</a></div>
