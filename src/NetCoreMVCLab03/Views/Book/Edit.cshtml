@model Book
@{
    ViewData["Title"] = "Chỉnh sửa sách";
    ViewData["Editing"] = true;
}
<h2>Chỉnh sửa sách</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="book-form" novalidate><partial name="_BookForm" model="Model" /></form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/book-form.js" asp-append-version="true"></script>
}
