<section aria-label="Banner" class="banner-section">
    <div id="myCarousel" class="carousel slide" aria-roledescription="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Banner ASP.NET"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1" aria-label="Banner Visual Studio"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2" aria-label="Banner Microsoft Azure"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active"><img src="~/images/banner1.png" alt="ASP.NET" width="1140" height="360" /></div>
            <div class="carousel-item"><img src="~/images/banner2.png" alt="Visual Studio" width="1140" height="360" /></div>
            <div class="carousel-item"><img src="~/images/banner3.png" alt="Microsoft Azure" width="1140" height="360" /></div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev" aria-label="Banner trước"><span class="carousel-control-prev-icon" aria-hidden="true"></span></button>
        <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next" aria-label="Banner tiếp"><span class="carousel-control-next-icon" aria-hidden="true"></span></button>
    </div>
    <button id="pauseBanner" type="button" class="btn btn-sm btn-outline-secondary mt-2" aria-pressed="false">Dừng trình chiếu</button>
</section>
